# Copy to .env.local (never commit real values).

# /lab contribution calendar (optional)
GITHUB_TOKEN=

# "Ask about me" chatbot (required for the assistant; without it the widget shows "offline")
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5)
# CHAT_MODEL=

# Admin (/keystatic) in production. Generated by Keystatic's GitHub App setup; see docs/v2/ADMIN-AND-CHAT.md
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# NEXT_PUBLIC_KEYSTATIC_REPO=madebyrazeen-portfolio
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github   # only to run the setup flow locally

# Admin sign-in (/admin) shared with Langkah and the course tracker. See docs/v2/ADMIN-SSO.md
# Same long random value in all three apps:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MBR_SSO_SECRET=
# MBR_SSO_COOKIE_DOMAIN=.madebyrazeen.com   # production only; leave unset on localhost
# ADMIN_GITHUB_LOGINS=razeeniqbal
# MBR_SSO_HOURS=12
# Defaults to the Keystatic GitHub App above; set these only to use a separate GitHub OAuth app.
# ADMIN_GITHUB_CLIENT_ID=
# ADMIN_GITHUB_CLIENT_SECRET=
# LANGKAH_URL=https://langkah.madebyrazeen.com
# TRACKER_URL=https://tracker.madebyrazeen.com
