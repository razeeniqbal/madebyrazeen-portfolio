{
  "name": "retro-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=4096 && next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:light": "set NODE_OPTIONS=--max-old-space-size=2048 && next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "powershell -Command \"Remove-Item -Path .next -Recurse -Force -ErrorAction SilentlyContinue\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "autoprefixer": "^10.4.18",
    "clsx": "^2.1.1",
    "next": "^16.1.1",
    "postcss": "^8.4.35",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "typescript": "^5.9.3"
  },
  "description": "Retro indie/90s portfolio built with Next.js",
  "author": "Razeen Iqbal",
  "license": "MIT"
}
