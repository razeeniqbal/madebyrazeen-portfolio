{
  "name": "razeen-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:light": "node --max-old-space-size=2048 node_modules/next/dist/bin/next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-keystatic.ts",
    "check:writing": "node scripts/check-writing.mjs",
    "check:links": "node scripts/check-links.mjs",
    "resume:pdf": "node scripts/build-resume-pdf.mjs",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "autoprefixer": "^10.4.18",
    "clsx": "^2.1.1",
    "next": "^16.1.1",
    "postcss": "^8.4.35",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "description": "Personal site of Razeen Iqbal: projects, experience, journal and running log. Next.js 16 + Keystatic.",
  "author": "Razeen Iqbal",
  "license": "MIT"
}
